{
  "name": "physical_lib",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.js",
  "description": "Physical Game Shelf - Nostalgic iOS 7 Bookshelf Edition",
  "author": "Protkan",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron": "electron electron/main.js",
    "start": "npm run build && electron electron/main.js",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.protkan.physicalgameshelf",
    "productName": "Physical Game Shelf",
    "copyright": "Copyright © 2026 Protkan",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/icon.jpg",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Physical Game Shelf",
      "uninstallDisplayName": "Physical Game Shelf Kaldır"
    }
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.88.0",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  }
}
